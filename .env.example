# Server-only settings for the API (artifacts/api-server). Never prefix
# secrets with PUBLIC_ or VITE_: nothing here may reach the browser.

# Contact form (Resend). onboarding@resend.dev only delivers to the Resend
# account owner; use a verified domain sender in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=anupam020202@gmail.com
CONTACT_FROM_EMAIL=Anupam Roy Portfolio <onboarding@resend.dev>
# Optional: sender tried once if CONTACT_FROM_EMAIL's domain is not verified.
CONTACT_FALLBACK_FROM_EMAIL=
# Optional: recipient used once if Resend only allows test emails.
RESEND_SANDBOX_TO_EMAIL=

# Ask the Atlas (owner decision D6). Leave the key empty, or set
# AI_ASSISTANT_ENABLED=false, to serve ledger evidence without AI.
GEMINI_API_KEY=
# Empty uses the default model (gemini-3.8-flash).
GEMINI_MODEL=
AI_ASSISTANT_ENABLED=true

# Optional: comma-separated provider policy ids to switch off (e.g. datacite,npm).
# On Vercel, redeploy after changing any variable.
PROVIDERS_DISABLED=

# Optional: raises GitHub's rate limit for the Repository Evidence Graph.
# Use a fine-grained token with no repository access (public data only).
GITHUB_TOKEN=

# Optional: contact address for Crossref's polite pool.
CROSSREF_MAILTO=

# Optional: 1 or true trusts X-Forwarded-For behind a reverse proxy outside Vercel.
TRUST_PROXY=

# Local development.
LOG_LEVEL=info
PORT=3001
HOST=127.0.0.1
# Where `astro dev` proxies /api during local development.
API_PROXY_TARGET=http://localhost:3001
# Port for the end-to-end test server.
E2E_PORT=4173
