{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && node --enable-source-maps ./dist/index.mjs | pino-pretty",
    "build": "node ./build.mjs",
