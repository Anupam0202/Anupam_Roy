---
import { caseDescription, softwareSourceCodeLd } from "../../lib/structured-data";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvidenceDrawer from "../../components/EvidenceDrawer.astro";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import ExternalLink from "../../components/ExternalLink.astro";
import { projects, reviewedTreeUrl, type Project } from "@workspace/proof-atlas-core/data/projects";

export function getStaticPaths() {
  return projects
    .filter((p) => p.slug !== "nexusrag" && p.slug !== "plantpal")
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const rankLabel = { flagship: "Flagship", featured: "Featured", lab: "Lab", archive: "Archive" }[p.rank];
const index = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(index + 1) % projects.length];
---

<BaseLayout title={`${p.name} case study`} description={caseDescription(p)} ogType="article" jsonLd={softwareSourceCodeLd(p)}>
  <header class="case-hero">
    <div class="container">
      <p class="eyebrow"><a href="/portfolio/">Portfolio</a> / {rankLabel} / {p.categories.join(" · ")}</p>
      <h1 class="h2 title">{p.name.split(/(?<=[_-])/).map((part, i) => (<>{i > 0 && <wbr />}{part}</>))}</h1>
      <p class="lead">{p.oneLiner}</p>
      <div class="cluster meta">
        <EvidenceBadge status="repository_documented" label="Repository inspected" claimId={p.claimIds[0]} />
        <span class="chip">Reviewed at {p.repository.commit.slice(0, 7)} · last commit {p.repository.committedOn}</span>
        <span class="chip">{p.repository.license ? `Licence ${p.repository.license}` : "No licence file"}</span>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container case-grid">
      <h2 class="h3">Problem</h2>
      <p class="prose">{p.problem}</p>
    </div>
  </section>

  <section class="section">
    <div class="container case-grid">
      <h2 class="h3">What the repository shows</h2>
      <div>
        <ul class="highlights">{p.highlights.map((h) => <li>{h}</li>)}</ul>
        <p class="tech mono">{p.tech.join(" · ")}</p>
        <EvidenceDrawer claimIds={p.claimIds} summary="Evidence for this project" />
      </div>
    </div>
  </section>

  {
    p.howItWorks && (
      <section class="section">
        <div class="container case-grid">
          <h2 class="h3">How it works</h2>
          <ol class="steps">{p.howItWorks.map((step) => <li>{step}</li>)}</ol>
        </div>
      </section>
    )
  }

  {
    p.engineering && (
      <section class="section">
        <div class="container case-grid">
          <h2 class="h3">Engineering evidence</h2>
          <div>
            <dl class="engineering-facts">
              {p.engineering.map((f) => (
                <div class="fact">
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
            <p class="hint">Counted from the repository at commit {p.repository.commit.slice(0, 7)}; the tests were not run for this site.</p>
          </div>
        </div>
      </section>
    )
  }

  {
    p.limitations && (
      <section class="section">
        <div class="container case-grid">
          <h2 class="h3">Limitations</h2>
          <ul class="highlights">{p.limitations.map((l) => <li>{l}</li>)}</ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container case-grid">
      <h2 class="h3">Links</h2>
      <div class="stack">
        <div class="cluster">
          <ExternalLink href={p.repository.url} class="button">Open the repository</ExternalLink>
          <ExternalLink href={reviewedTreeUrl(p)} class="button button--ghost">Reviewed commit {p.repository.commit.slice(0, 7)}</ExternalLink>
          {p.site && <ExternalLink href={p.site.href} class="button button--ghost">{p.site.label}</ExternalLink>}
        </div>
        {p.site && <p class="hint">Link from the {p.site.source}; its availability has not been checked.</p>}
        <p class="small">
          Next: <a href={`/portfolio/${next.slug}/`}>{next.name}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .case-hero {
    padding-block: clamp(40px, 5vw + 12px, 96px) clamp(32px, 3vw, 56px);
    border-bottom: 1px solid var(--line-soft);
  }
  .case-hero .eyebrow a {
    color: inherit;
  }
  .title {
    margin-top: var(--space-4);
    overflow-wrap: anywhere;
  }
  .case-hero .lead {
    margin-top: var(--space-4);
  }
  .meta {
    margin-top: var(--space-5);
  }
  .highlights {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 8px;
  }
  .tech {
    margin: var(--space-5) 0;
    color: var(--ink-muted);
  }
  .steps {
    margin: 0;
    padding-left: 1.4em;
    display: grid;
    gap: 10px;
  }
  .steps li::marker {
    font-family: var(--font-mono);
    color: var(--ink-muted);
  }
  .engineering-facts {
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line-soft);
  }
  .fact {
    display: grid;
    gap: 2px var(--space-4);
    padding: 12px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  @media (min-width: 640px) {
    .fact {
      grid-template-columns: 9rem minmax(0, 1fr);
    }
  }
  .fact dt {
    font-weight: 650;
  }
  .fact dd {
    margin: 0;
    color: var(--ink-muted);
  }
  .engineering-facts + .hint {
    margin-top: var(--space-3);
  }
</style>
