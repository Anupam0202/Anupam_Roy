---
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemBecomingClear from "../components/SystemBecomingClear.astro";
import NexusLanesMini from "../components/diagrams/NexusLanesMini.astro";
import PlantPalLayersMini from "../components/diagrams/PlantPalLayersMini.astro";
import EvidenceBadge from "../components/EvidenceBadge.astro";
import ExternalLink from "../components/ExternalLink.astro";
import { education, profile, outcomes, OUTCOME_QUALIFIER, principles, SITE, skillGroups } from "@workspace/proof-atlas-core/data/profile";
import { roles } from "@workspace/proof-atlas-core/data/experience";
import { projectBySlug, projects } from "@workspace/proof-atlas-core/data/projects";
import { credentials } from "@workspace/proof-atlas-core/data/credentials";

const nexus = projectBySlug("nexusrag")!;
const plant = projectBySlug("plantpal")!;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: profile.name,
      jobTitle: profile.currentTitle,
      worksFor: { "@type": "Organization", name: profile.employer },
      email: `mailto:${profile.email}`,
      url: SITE.url,
      homeLocation: { "@type": "Place", name: profile.location },
      alumniOf: { "@type": "CollegeOrUniversity", name: education[0].college },
      knowsAbout: skillGroups.flatMap((g) => g.skills),
      sameAs: [profile.links.github, profile.links.linkedin, profile.links.credly, profile.links.codechef],
    },
    { "@type": "WebSite", name: SITE.name, url: SITE.url },
  ],
};
const thinking = [
  { n: "01", title: "Problem", text: "Name who is stuck, on what, and what a good outcome looks like — before choosing any model or tool." },
  { n: "02", title: "Constraints", text: "Write down what must never happen: leaked data, invented answers, unbounded cost, actions without review." },
  { n: "03", title: "System", text: "Compose bounded parts — routing, retrieval, generation, validation — each with a clear failure mode." },
  { n: "04", title: "Evidence", text: "Make every claim traceable to its source, and say plainly what is not yet established." },
];
---

<BaseLayout
  preloadSerif
  title="Home"
  description="Anupam Roy builds retrieval systems, intelligent applications and dependable software, and shows the evidence behind each claim."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><b>Anupam Roy</b> / AI + software engineering</p>
        <h1 class="display headline">I turn difficult problems into <span class="serif">understandable systems.</span></h1>
        <p class="lead">{profile.lede}</p>
        <div class="cluster ctas">
          <a class="button" href="/portfolio/">Explore Portfolio <span class="arrow" aria-hidden="true"></span></a>
          <a class="button button--ghost" href="/workbench/">Open Proof Workbench</a>
        </div>
        <p class="cluster secondary small">
          <ExternalLink href={profile.links.github} class="text-link">GitHub</ExternalLink>
          <ExternalLink href={profile.links.linkedin} class="text-link">LinkedIn</ExternalLink>
          <span class="muted">{profile.currentTitle}, {profile.employer}</span>
        </p>
      </div>
      <div class="hero-visual">
        <SystemBecomingClear />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="selected-proof">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">01 · Selected proof</p>
        <h2 id="selected-proof" class="h2">Two systems, opened up.</h2>
        <p class="lead">Each case study separates what runs, what is documented and what is not yet established — with links to the exact lines of source.</p>
      </div>
      <div class="grid grid--2 covers">
        {
          [
            { p: nexus, Diagram: NexusLanesMini, angle: "Bounded runtime vs research pipeline" },
            { p: plant, Diagram: PlantPalLayersMini, angle: "Many public signals, honest uncertainty" },
          ].map(({ p, Diagram, angle }) => (
            <article class="card cover">
              <div class="cover-art">
                <Diagram />
              </div>
              <p class="eyebrow">{angle}</p>
              <h3 class="h3">
                <a class="card-link" href={`/portfolio/${p.slug}/`}>{p.name}</a>
              </h3>
              <p class="muted">{p.oneLiner}</p>
              <p class="cluster small">
                <span class="chip">{p.claimIds.length} evidence entries</span>
                <span class="chip">Reviewed {p.reviewedOn}</span>
              </p>
              <p class="text-link" aria-hidden="true">
                Read the case study <span class="arrow" />
              </p>
            </article>
          ))
        }
      </div>
      <p class="more"><a class="text-link" href="/portfolio/">All {projects.length} projects <span class="arrow" aria-hidden="true"></span></a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="how-i-think">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">02 · How I think</p>
        <h2 id="how-i-think" class="h2">{profile.thesis}</h2>
      </div>
      <ol class="grid grid--4 thinking">
        {
          thinking.map((t) => (
            <li class="think">
              <span class="mono muted">{t.n}</span>
              <h3 class="h4">{t.title}</h3>
              <p class="muted">{t.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section workbench-band" aria-labelledby="workbench-preview">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">03 · Proof Workbench</p>
        <h2 id="workbench-preview" class="h2">Tools that show their working.</h2>
        <p class="lead">Small, useful workflows built on the same evidence principles as the case studies. No account needed.</p>
      </div>
      <div class="grid grid--3">
        <article class="card">
          <p class="eyebrow">Public GitHub data</p>
          <h3 class="h4"><a class="card-link" href="/workbench/repository/">Repository Evidence Graph</a></h3>
          <p class="muted small">Map a public repository's README, releases, manifests, languages and licence — and see exactly what was not inspected.</p>
        </article>
        <article class="card">
          <p class="eyebrow">Runs in your browser</p>
          <h3 class="h4"><a class="card-link" href="/workbench/documents/">Local Document Evidence</a></h3>
          <p class="muted small">Search your own text files with BM25 and exact phrases, then export the passages as an evidence packet. Nothing is uploaded.</p>
        </article>
        <article class="card">
          <p class="eyebrow">Crossref + DataCite</p>
          <h3 class="h4"><a class="card-link" href="/workbench/citations/">Citation Integrity</a></h3>
          <p class="muted small">Resolve DOIs, compare providers, flag missing fields and export clean BibTeX, RIS or CSL-JSON.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="experience-preview">
    <div class="container two-col">
      <div class="section-head">
        <p class="eyebrow">04 · Experience</p>
        <h2 id="experience-preview" class="h2">From software foundations to intelligent systems.</h2>
        <p><a class="text-link" href="/experience/">Read the experience record <span class="arrow" aria-hidden="true"></span></a></p>
      </div>
      <ol class="timeline">
        {
          roles.map((r) => (
            <li>
              <p class="mono muted">{r.period}</p>
              <h3 class="h4">
                {r.title} · {r.company}
              </h3>
              <p class="muted">{r.summary}</p>
            </li>
          ))
        }
        <li class="outcomes">
          <div class="cluster">
            {outcomes.map((o) => (
              <p class="outcome">
                <span class="outcome-value">{o.value}</span>
                <span class="small">{o.label}</span>
              </p>
            ))}
          </div>
          <p class="small muted qualifier">
            <EvidenceBadge status="owner_reported" claimId="exp-outcomes" /> {OUTCOME_QUALIFIER}
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="lab-preview">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">05 · Engineering Lab</p>
        <h2 id="lab-preview" class="h2">Algorithms you can step through.</h2>
      </div>
      <div class="grid grid--2">
        <article class="card lab-card">
          <p class="formula mono" aria-hidden="true">RRF(d)&nbsp;= Σ&nbsp;1&nbsp;/&nbsp;(k&nbsp;+&nbsp;rankᵢ(d))</p>
          <h3 class="h4"><a class="card-link" href="/lab/retrieval-fusion/">Reciprocal Rank Fusion</a></h3>
          <p class="muted small">Fuse a lexical and a semantic ranking, see every contribution, then compare with NexusRAG's actual gateway blend.</p>
        </article>
        <article class="card lab-card">
          <p class="formula mono" aria-hidden="true">low&nbsp;≤ target&nbsp;≤ high</p>
          <h3 class="h4"><a class="card-link" href="/lab/binary-search/">Binary Search</a></h3>
          <p class="muted small">Watch the interval halve, with the invariant stated and checked at every step.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="recognition-preview">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">06 · Evidence and recognition</p>
        <h2 id="recognition-preview" class="h2">Supporting signals, labelled honestly.</h2>
      </div>
      <dl class="grid grid--3 signals">
        <div class="card">
          <dt class="eyebrow">Credential records</dt>
          <dd>
            <span class="signal-value">{credentials.length}</span>
            <span class="small muted">certificate PDFs, issue dates and IDs checked; issuer links not yet checked</span>
            <a class="text-link small" href="/credentials/">Browse the index <span class="arrow" aria-hidden="true"></span></a>
          </dd>
        </div>
        <div class="card">
          <dt class="eyebrow">CodeChef</dt>
          <dd>
            <span class="signal-value">5★ · 2109</span>
            <span class="small muted">5-Star tier, peak rating 2109</span>
            <EvidenceBadge status="owner_reported" claimId="codechef" />
          </dd>
        </div>
        <div class="card">
          <dt class="eyebrow">Credly</dt>
          <dd>
            <span class="signal-value">180+</span>
            <span class="small muted">badges; Top Badge Earner 2024</span>
            <EvidenceBadge status="owner_reported" claimId="credly" />
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="about-preview">
    <div class="container two-col">
      <div class="section-head">
        <p class="eyebrow">07 · About</p>
        <h2 id="about-preview" class="h2">Principles I build by.</h2>
        <p><a class="text-link" href="/about/">More about Anupam <span class="arrow" aria-hidden="true"></span></a></p>
      </div>
      <ul class="principles">
        {
          principles.map((p) => (
            <li>
              <h3 class="h4">{p.title}</h3>
              <p class="muted">{p.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="finale" aria-labelledby="contact-finale">
    <div class="container">
      <p class="eyebrow">08 · Contact</p>
      <h2 id="contact-finale" class="display finale-title">Have a difficult problem? <span class="serif">Let's make it understandable.</span></h2>
      <div class="cluster ctas">
        <a class="button button--signal" href="/contact/">Start a conversation</a>
        <a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Links to the previous single-page site used hash anchors; send them to the new routes.
  const legacy: Record<string, string> = {
    "#about": "/about/",
    "#experience": "/experience/",
    "#systems": "/experience/#systems",
    "#projects": "/portfolio/",
    "#certifications": "/credentials/",
    "#achievements": "/credentials/#recognition",
    "#education": "/about/#education",
    "#contact": "/contact/",
  };
  const target = legacy[location.hash.toLowerCase()];
  if (target) location.replace(target);
</script>

<style>
  .hero {
    padding-block: clamp(40px, 5vw + 8px, 96px) clamp(48px, 6vw, 112px);
  }
  .hero-grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 1100px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: var(--space-9);
    }
  }
  .headline {
    margin-top: var(--space-5);
    max-width: 14ch;
    /* The spec hero scale is sized for a single column; this hero shares the row with the illustration. */
    font-size: clamp(2.75rem, 1.1rem + 4.6vw, 5.75rem);
  }
  .headline .serif {
    font-weight: 400;
  }
  .hero-copy .lead {
    margin-top: var(--space-6);
  }
  .ctas {
    margin-top: var(--space-6);
  }
  .secondary {
    margin-top: var(--space-4);
    gap: var(--space-5);
  }
  .section-head {
    max-width: 880px;
    margin-bottom: var(--space-7);
  }
  /* In two-column sections the grid gap already separates the head from the content. */
  .two-col .section-head {
    margin-bottom: 0;
  }
  .section-head .h2 {
    margin-top: var(--space-3);
  }
  .section-head .lead {
    margin-top: var(--space-4);
  }
  .covers .cover {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .cover-art {
    margin-bottom: var(--space-3);
    padding: var(--space-4);
    background: var(--paper);
    border-radius: var(--radius-md);
    border: 1px solid var(--line-soft);
  }
  .more {
    margin-top: var(--space-5);
  }
  .thinking {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: none;
  }
  .think {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-4);
    border-top: 2px solid var(--ink);
  }
  .workbench-band {
    background: var(--surface);
  }
  .workbench-band .card {
    background: var(--paper);
  }
  .two-col {
    display: grid;
    gap: var(--space-7);
  }
  @media (min-width: 1024px) {
    .two-col {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
    }
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--line);
  }
  .timeline > li {
    position: relative;
    padding: 0 0 var(--space-6) var(--space-6);
  }
  .timeline > li::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--ink);
  }
  .timeline > li:first-child::before {
    background: var(--signal);
    border-color: var(--signal-ink);
  }
  .timeline h3 {
    margin-top: 4px;
  }
  .timeline .muted {
    margin-top: 6px;
  }
  .timeline .outcomes::before {
    display: none;
  }
  .outcome {
    display: grid;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .outcome-value {
    font-size: 2rem;
    font-weight: 780;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .qualifier {
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .formula {
    padding: var(--space-3) var(--space-4);
    background: var(--paper);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
    font-size: 1rem;
    /* Non-breaking spaces keep each side whole; on a narrow card it breaks only after "=" or "≤". */
  }
  .lab-card h3 {
    margin-bottom: var(--space-2);
  }
  .signals {
    margin: 0;
  }
  .signals dd {
    margin: var(--space-2) 0 0;
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .signal-value {
    font-size: clamp(2rem, 1.6rem + 1.6vw, 3rem);
    font-weight: 780;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 640px) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .principles li {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .finale {
    padding-block: clamp(80px, 8vw + 32px, 160px);
    background: var(--ink);
    color: var(--paper);
  }
  .finale .eyebrow {
    color: var(--line);
  }
  .finale-title {
    margin-top: var(--space-4);
    max-width: 16ch;
    font-size: clamp(2.15rem, 1.2rem + 5vw, 6.5rem);
  }
  .finale .text-link {
    color: var(--paper);
    text-decoration-color: var(--line);
  }
  .finale :focus-visible {
    outline-color: var(--signal);
  }
</style>
