---
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidenceBadge from "../components/EvidenceBadge.astro";
import EvidenceDrawer from "../components/EvidenceDrawer.astro";
import ExternalLink from "../components/ExternalLink.astro";
import CredentialIndex from "../islands/CredentialIndex";
import {
  credentials,
  CREDENTIAL_DISCLOSURE,
  displayTitle,
  featuredCredentials,
  formatCredentialDate,
  issuerCounts,
  yearCounts,
} from "@workspace/proof-atlas-core/data/credentials";
import { SITE, profile } from "@workspace/proof-atlas-core/data/profile";

const featured = featuredCredentials();
const years = yearCounts();
const issuers = issuerCounts();
const photos = [
  { src: "google-cloud-swag-collection", alt: "Google Cloud Arcade rewards laid out together", w: 800, h: 717 },
  { src: "google-cloud-jacket-bottle", alt: "Google Cloud Arcade jacket and bottle", w: 800, h: 600 },
  { src: "google-cloud-pen-set", alt: "Google Cloud Arcade pen set", w: 1200, h: 765 },
  { src: "google-cloud-vacuum-printer", alt: "Google Cloud Arcade vacuum and printer rewards", w: 800, h: 666 },
];
---

<BaseLayout title="Credentials" description={`${credentials.length} cloud, data and AI credential records with certificate PDFs, issue dates, credential IDs and issuer links, plus recognition.`}>
  <section class="cred-hero">
    <div class="container">
      <p class="eyebrow">Credentials / Wall of Mastery</p>
      <h1 class="h2 title">{credentials.length} credentials, each with its certificate.</h1>
      <p class="lead disclosure-line">{CREDENTIAL_DISCLOSURE}</p>
      <p class="small muted">Each record shows the issue date printed on its certificate. Source reviewed {SITE.reviewedAt}.</p>
      <form class="hero-search" action="#index-h" method="get" role="search" aria-label="Search all credentials" data-hero-search>
        <label for="cred-hero-q">Search titles, issuers and credential IDs</label>
        <div class="tool-row">
          <input id="cred-hero-q" name="q" type="search" class="input" autocomplete="off" />
          <button class="button" type="submit">Search</button>
        </div>
      </form>
      <div class="summary">
        <dl class="stat-grid" aria-label="Records by issue year">
          {
            years.map((y) => (
              <div class="stat">
                <dt class="small">Issued in {y.year}</dt>
                <dd data-year-count={y.year}>{y.count}</dd>
              </div>
            ))
          }
        </dl>
        <ul class="issuers cluster" aria-label="Records by issuer">
          {issuers.map((i) => <li class="chip">{i.issuer} · {i.count}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="featured-h">
    <div class="container">
      <h2 id="featured-h" class="h3">Highlights for AI and cloud roles</h2>
      <p class="muted small featured-note">Owner-selected from the full list below.</p>
      <ul class="featured">
        {
          featured.map((c) => (
            <li class="card" data-featured-item>
              <p class="eyebrow">{c.issuer}</p>
              <p class="featured-title">{displayTitle(c.title)}</p>
              <p class="small muted">Issued on <time datetime={c.issuedOn}>{formatCredentialDate(c.issuedOn)}</time></p>
              <p class="cluster small">
                <a href={`/${c.pdf}`} target="_blank" rel="noopener noreferrer">Certificate PDF<span class="visually-hidden"> for {displayTitle(c.title)} (opens in a new tab)</span></a>
                <a href={c.verifyUrl} target="_blank" rel="noopener noreferrer">Issuer page<span class="visually-hidden"> for {displayTitle(c.title)} (opens in a new tab)</span></a>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="index-h">
    <div class="container">
      <h2 id="index-h" class="h3">All {credentials.length} records</h2>
      <div class="index-wrap">
        <CredentialIndex client:idle />
        <noscript><p class="notice small">Search and filters need JavaScript. Every credential is listed here without them.</p></noscript>
      </div>
      <EvidenceDrawer claimIds={["cred-records"]} summary="How these records were checked" />
    </div>
  </section>

  <section id="recognition" class="section" aria-labelledby="recognition-h">
    <div class="container">
      <p class="eyebrow">Recognition</p>
      <h2 id="recognition-h" class="h3">Supporting signals</h2>
      <div class="grid grid--3 recog">
        <article class="card">
          <h3 class="h4">CodeChef 5-Star</h3>
          <p class="signal-value">2109</p>
          <p class="small muted">Peak rating; 5-Star tier reached through sustained algorithmic practice.</p>
          <p class="cluster small"><EvidenceBadge status="owner_reported" claimId="codechef" /><ExternalLink href={profile.links.codechef}>CodeChef profile</ExternalLink></p>
        </article>
        <article class="card">
          <h3 class="h4">Credly</h3>
          <p class="signal-value">180+</p>
          <p class="small muted">Digital badges, and Top Badge Earner recognition for 2024.</p>
          <img
            class="badge-img"
            src="/images/recognition/credly-top-badge-earner-240.webp"
            srcset="/images/recognition/credly-top-badge-earner-240.webp 240w, /images/recognition/credly-top-badge-earner.webp 610w"
            sizes="120px"
            alt="Credly Top Badge Earner 2024 badge"
            width="240"
            height="240"
            loading="lazy"
            decoding="async"
          />
          <p class="cluster small"><EvidenceBadge status="owner_reported" claimId="credly" /><ExternalLink href={profile.links.credly}>Credly profile</ExternalLink></p>
        </article>
        <article class="card">
          <h3 class="h4">Google Cloud</h3>
          <p class="small muted">Early-adopter recognition, three Technical Expert badges, four consecutive Arcade seasons and a Legend milestone.</p>
          <p class="cluster small"><EvidenceBadge status="owner_reported" claimId="gcp-arcade" /><ExternalLink href="https://www.linkedin.com/posts/anupam--roy_googlecloud-gcp-learninganddevelopment-activity-7385948527765639168-SuDJ">Legend milestone post</ExternalLink></p>
        </article>
      </div>
      <ul class="photos" aria-label="Google Cloud Arcade rewards">
        {
          photos.map((p) => (
            <li>
              <figure>
                <img
                  src={`/images/recognition/${p.src}-480.webp`}
                  srcset={`/images/recognition/${p.src}-480.webp 480w, /images/recognition/${p.src}.webp ${p.w}w`}
                  sizes="(min-width: 900px) 25vw, 50vw"
                  alt={p.alt}
                  width={p.w}
                  height={p.h}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  // The hero search drives the index below.
  const heroSearch = document.querySelector<HTMLFormElement>("[data-hero-search]");
  heroSearch?.addEventListener("submit", (event) => {
    event.preventDefault();
    const q = (heroSearch.elements.namedItem("q") as HTMLInputElement).value.trim();
    // The index reads ?q= when it hydrates and listens for this event afterwards.
    const params = new URLSearchParams(location.search);
    if (q) params.set("q", q);
    else params.delete("q");
    const query = params.toString();
    history.replaceState(null, "", `${query ? `?${query}` : location.pathname}${location.hash}`);
    window.dispatchEvent(new CustomEvent("credential-search", { detail: q }));
    document.getElementById("index-h")?.scrollIntoView();
  });
</script>

<style>
  .hero-search {
    margin-top: var(--space-5);
    max-width: 36rem;
  }
  .hero-search label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .cred-hero {
    padding-block: clamp(48px, 6vw + 16px, 112px) clamp(32px, 4vw, 64px);
    border-bottom: 1px solid var(--line-soft);
  }
  .title {
    margin-top: var(--space-4);
    max-width: 16ch;
  }
  .disclosure-line {
    margin-top: var(--space-5);
    color: var(--ink);
  }
  .disclosure-line + p {
    margin-top: var(--space-3);
  }
  .summary {
    margin-top: var(--space-6);
  }
  .stat-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    max-width: 720px;
  }
  @media (min-width: 640px) {
    .stat-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .stat {
    display: grid;
    align-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .stat dd {
    margin: 0;
    font-size: 2rem;
    font-weight: 780;
    letter-spacing: -0.03em;
  }
  .issuers {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
  }
  .featured-note {
    margin: var(--space-2) 0 var(--space-4);
  }
  .featured {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .featured {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .featured {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .featured .card {
    display: grid;
    gap: 6px;
  }
  .featured-title {
    font-weight: 700;
  }
  .index-wrap {
    margin: var(--space-5) 0 var(--space-6);
  }
  .recog {
    margin-top: var(--space-5);
  }
  .recog .card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .signal-value {
    font-size: 2.6rem;
    font-weight: 780;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .badge-img {
    width: 120px;
    height: auto;
  }
  .photos {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 900px) {
    .photos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .photos figure {
    margin: 0;
  }
  .photos img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
  }
</style>
