---
/** Cover diagram: environmental source layers with differing resolution. */
const bands = [
  { y: 22, label: "weather", step: 14, cls: "b1" },
  { y: 70, label: "air", step: 22, cls: "b2" },
  { y: 118, label: "soil", step: 8, cls: "b3" },
  { y: 166, label: "biodiversity", step: 30, cls: "b4" },
];
---

<svg viewBox="0 0 520 260" class="plant-mini" role="img" aria-labelledby="plant-mini-title plant-mini-desc">
  <title id="plant-mini-title">PlantPal: layered environmental signals</title>
  <desc id="plant-mini-desc">
    Four horizontal bands stand for weather, air quality, soil and biodiversity signals. Each band is sampled at a different grid size, showing different resolutions. They converge on one point that an AI suggestion is drawn from, with a dashed uncertainty halo.
  </desc>
  {
    bands.map((b) => (
      <g class={`band ${b.cls}`}>
        <rect x="10" y={b.y} width="380" height="36" rx="10" />
        {Array.from({ length: Math.floor(360 / b.step) }, (_, i) => (
          <path d={`M${22 + i * b.step} ${b.y + 8}v20`} class="tickmark" />
        ))}
      </g>
    ))
  }
  <path d="M390 40C430 40 430 118 452 130M390 88C420 88 430 124 452 130M390 136H452M390 184C420 184 430 140 452 132" class="converge"></path>
  <circle cx="466" cy="132" r="34" class="halo"></circle>
  <circle cx="466" cy="132" r="14" class="point"></circle>
  <path d="M10 224h380" class="baseline"></path>
  <path d="M10 216v16M200 216v16M390 216v16" class="baseline"></path>
</svg>

<style>
  .plant-mini {
    width: 100%;
  }
  .band rect {
    stroke-width: 1.2;
  }
  .b1 rect {
    fill: var(--tech-soft);
    stroke: var(--tech);
  }
  .b2 rect {
    fill: var(--surface);
    stroke: var(--line-strong);
  }
  .b3 rect {
    fill: var(--copper-soft);
    stroke: var(--copper);
  }
  .b4 rect {
    fill: var(--surface);
    stroke: var(--ink);
  }
  .tickmark {
    stroke: var(--ink-muted);
    stroke-width: 1;
    opacity: 0.45;
  }
  .converge {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
  }
  .halo {
    fill: none;
    stroke: var(--copper);
    stroke-width: 1.4;
    stroke-dasharray: 4 5;
  }
  .point {
    fill: var(--signal);
    stroke: var(--signal-ink);
    stroke-width: 1.8;
  }
  .baseline {
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }
</style>
